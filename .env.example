# ---------------------------------------------------------------------------
# Wohnungsbot — Konfiguration
# Kopiere nach .env und fülle die Werte. .env ist gitignored.
# ---------------------------------------------------------------------------

# --- Pfade -----------------------------------------------------------------
DB_PATH=data/wohnungsbot.db
SNAPSHOT_DIR=data/snapshots
LLM_LOG_DIR=data/llm-log

# --- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Modell-Zuordnung pro Stufe --------------------------------------------
# Format: provider:model. Unbekannter Provider oder fehlender Adapter
# => Startfehler, kein stiller Fallback (§11).
# Modell-IDs geprüft gegen ai.google.dev/gemini-api/docs/models am 2026-08-20.
# ACHTUNG: "gemini-3.1-pro" existiert nicht als API-ID — der Pro-Stand der
# 3.1-Familie heißt "gemini-3.1-pro-preview" (siehe README, Abweichung 1).
STAGE_EXTRACT=gemini:gemini-3.5-flash-lite
STAGE_GATE=gemini:gemini-3.7-flash
STAGE_DRAFT=gemini:gemini-3.7-flash
STAGE_DRAFT_PRIVAT=gemini:gemini-3.1-pro-preview
STAGE_RESEARCH_FIRMA=gemini:gemini-3.7-flash
STAGE_RESEARCH_PERSON=gemini:gemini-3.1-pro-preview

# --- Timeouts je Stufe in Millisekunden ------------------------------------
# Nur setzen, wenn du von den Vorgaben abweichen willst. Die Recherche liegt
# bewusst über dem in §8 genannten Wert — sie läuft einmal pro Firma, und
# eine fehlende Adresse kostet den ganzen Direktkanal. Siehe src/llm/registry.ts.
# STAGE_TIMEOUT_EXTRACT=8000
# STAGE_TIMEOUT_GATE=8000
# STAGE_TIMEOUT_RESEARCH_FIRMA=90000
# STAGE_TIMEOUT_RESEARCH_PERSON=180000

# --- Kostenbudget (§16) ----------------------------------------------------
COST_WARN_USD_PER_DAY=2
COST_STOP_USD_PER_DAY=5

# --- Rohausgaben mitschreiben (§11: "raw immer mitschreiben") --------------
LLM_LOG=1

# ---------------------------------------------------------------------------
# Ab hier: spätere Phasen. Für Phase 1 nicht nötig, hier nur als Vorschau.
# ---------------------------------------------------------------------------

# Phase 4 — Google Places Seeding (§17)
GOOGLE_PLACES_API_KEY=

# Phase 6 — HTTP-Service
PORT=8787

# Phase 7 — Gmail-Versand
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
SEND_MAX_PER_DAY=20
SEND_UNDO_WINDOW_SECONDS=60

# Nur falls später ein Anthropic-Adapter dazukommt (§11). Für die
# Startkonfiguration NICHT nötig.
ANTHROPIC_API_KEY=
