{
  "name": "autoflat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "db:init": "node scripts/db-init.ts",
    "db:reset": "node scripts/db-init.ts --force",
    "llm:smoke": "node scripts/smoke-llm.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "extract:fixtures": "node scripts/extract-fixtures.ts",
    "draft:render": "node scripts/render-draft.ts",
    "prewarm:batch": "node scripts/prewarm-batch.ts",
    "prewarm:import": "node scripts/prewarm-import.ts",
    "seed:places": "node scripts/seed-places.ts",
    "research:firma": "node scripts/research-firma.ts",
    "pipeline": "node scripts/pipeline.ts",
    "grounding:check": "node scripts/grounding-check.ts",
    "gate:fixtures": "node scripts/gate-fixtures.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
